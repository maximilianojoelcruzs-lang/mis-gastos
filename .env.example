# Copia este archivo como .env.local para desarrollo local.
# En Vercel las define sola la integración de Supabase (Storage → Supabase);
# si no, configúralas en Settings → Environment Variables.

# Supabase (públicas: se envían al navegador). Sirve la clave "anon" o la "publishable".
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon
